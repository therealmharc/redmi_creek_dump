<?xml version="1.0" encoding="UTF-8"?>

<SarDsiConfig>
    <!-- use for sar uncouple framework -->
    <sarVersion>2</sarVersion>
    <!-- only use for india -->
    <deviceSarConfig device_name="creek">
        <prop prop_name="ro.boot.hwc">India</prop>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2,mcc,wifi,cable,hall,usb,lab -->
        <listeners>100000000000</listeners>
        <!-- receiver -->
        <dsimap value="1">1</dsimap>
        <dsimap value="0">2</dsimap>
    </deviceSarConfig>

    <!-- default configuration. -->
    <deviceSarConfig device_name="creek">
        <prop prop_name="ro.boot.hwc">Global</prop>
		<!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2 -->
        <listeners>111111000000</listeners>
        <!-- receiver,hotSpot(wifi_spot,(bluetooth,bluetooth_pan)),sarsensor1,sarsensor2 -->
        <dsimap value="10FF">1</dsimap>
        <dsimap value="0010">2</dsimap>
		<dsimap value="00F1">3</dsimap>
		<dsimap value="0000">4</dsimap>
		<dsimap value="F1FF">5</dsimap>
    </deviceSarConfig>

    <!-- default configuration. -->
    <deviceSarConfig device_name="creek">
        <prop prop_name="ro.boot.hwc">default</prop>
        <listeners>111111000000</listeners>
        <!-- receiver -->
		<dsimap value="10FF">1</dsimap>
                <dsimap value="0010">2</dsimap>
		<dsimap value="00F1">3</dsimap>
		<dsimap value="0000">4</dsimap>
		<dsimap value="F1FF">5</dsimap>
    </deviceSarConfig>

</SarDsiConfig>
