						drive-strength = <0x02>;
						pins = "gpio18";
					};
				};

				wsa_mclk_active {
					phandle = <0x25e>;

					mux {
						function = "func1";
						pins = "gpio18";
					};

					config {
						output-high;
						bias-disable;
						drive-strength = <0x10>;
						pins = "gpio18";
					};
				};
