/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Bengalp SoC";
	compatible = "qcom,bengalp";
	qcom,msm-id = <0x1a4 0x10000 0x1bd 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x200>;
	};

	aliases {
		swr1 = "/soc/spf_core_platform/bolero-codec/rx-macro@a600000/rx_swr_master";
		swr0 = "/soc/spf_core_platform/bolero-codec/va-macro@a730000/va_swr_master";
		mmc0 = "/soc/sdhci@4744000";
		mmc1 = "/soc/sdhci@4784000";
		ufshc1 = "/soc/ufshc@4804000";
		serial0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a90000";
		hsuart0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a8c000";
		phandle = <0x120>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x07>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x04>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x121>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x122>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x01>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x07>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			phandle = <0x0c>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x123>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x124>;
			};
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x02>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x07>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			phandle = <0x0d>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x125>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x126>;
			};
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x03>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x07>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			phandle = <0x0e>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x127>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x128>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x100>;
			cpu-idle-states = <0x07>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			enable-method = "psci";
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x05 0x01 0x07>;
			qcom,lmh-dcvs = <0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x0f>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x09>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x129>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x12a>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x101>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			cpu-idle-states = <0x07>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x05 0x01 0x07>;
			qcom,lmh-dcvs = <0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x10>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x12b>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x12c>;
			};
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x102>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			cpu-idle-states = <0x07>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x05 0x01 0x07>;
			qcom,lmh-dcvs = <0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x11>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x12d>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x12e>;
			};
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x103>;
			capacity-dmips-mhz = <0x666>;
			dynamic-power-coefficient = <0x11a>;
			cpu-idle-states = <0x07>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x09>;
			qcom,freq-domain = <0x05 0x01 0x07>;
			qcom,lmh-dcvs = <0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x12>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0x12f>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0x130>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x0c>;
				};

				core2 {
					cpu = <0x0d>;
				};

				core3 {
					cpu = <0x0e>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x0f>;
				};

				core1 {
					cpu = <0x10>;
				};

				core2 {
					cpu = <0x11>;
				};

				core3 {
					cpu = <0x12>;
				};
			};
		};
	};

	idle-states {

		silver-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <0x129>;
			exit-latency-us = <0x144>;
			min-residency-us = <0x456>;
			arm,psci-suspend-param = <0x40000003>;
			local-timer-stop;
			phandle = <0x02>;
		};

		gold-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <0x122>;
			exit-latency-us = <0x178>;
			min-residency-us = <0x49e>;
			arm,psci-suspend-param = <0x40000003>;
			local-timer-stop;
			phandle = <0x07>;
		};

		silver-cluster-d3 {
			compatible = "domain-idle-state";
			idle-state-name = "pwr-l2-pc";
			entry-latency-us = <0x280>;
			exit-latency-us = <0x680>;
			min-residency-us = <0x1f9e>;
			arm,psci-suspend-param = <0x41000043>;
			phandle = <0x16>;
		};

		gold-cluster-d3 {
			compatible = "domain-idle-state";
			idle-state-name = "perf-l2-pc";
			entry-latency-us = <0x320>;
			exit-latency-us = <0x846>;
			min-residency-us = <0x1cd0>;
			arm,psci-suspend-param = <0x41000043>;
			phandle = <0x17>;
		};

		cluster-e1 {
			compatible = "domain-idle-state";
			idle-state-name = "cci-ret";
			entry-latency-us = <0x6c>;
			exit-latency-us = <0x1c2>;
			min-residency-us = <0x99>;
			arm,psci-suspend-param = <0x42000043>;
			phandle = <0x19>;
		};

		cluster-e3 {
			compatible = "domain-idle-state";
			idle-state-name = "cci-pc";
			entry-latency-us = <0x2a4f>;
			exit-latency-us = <0x119a>;
			min-residency-us = <0x3bea>;
			arm,psci-suspend-param = <0x42000343>;
			phandle = <0x1a>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		cpu-pd0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x13>;
			phandle = <0x03>;
		};

		cpu-pd1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x13>;
			phandle = <0x131>;
		};

		cpu-pd2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x13>;
			phandle = <0x132>;
		};

		cpu-pd3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x13>;
			phandle = <0x133>;
		};

		cpu-pd4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x14>;
			phandle = <0x08>;
		};

		cpu-pd5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x14>;
			phandle = <0x134>;
		};

		cpu-pd6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x14>;
			phandle = <0x135>;
		};

		cpu-pd7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x14>;
			phandle = <0x136>;
		};

		cluster-pd0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x15>;
			domain-idle-states = <0x16>;
			phandle = <0x13>;
		};

		cluster-pd1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x15>;
			domain-idle-states = <0x17>;
			phandle = <0x14>;
		};

		cluster-pd2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x18>;
			domain-idle-states = <0x19>;
			phandle = <0x15>;
		};

		cluster-pd3 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x1a>;
			phandle = <0x18>;
		};
	};

	firmware {
		phandle = <0x137>;

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x1b 0x13000>;
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/4744000.sdhci/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,avb";
					status = "ok";
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x138>;

		hyp_region@45700000 {
			no-map;
			reg = <0x00 0x45700000 0x00 0x600000>;
			phandle = <0x139>;
		};

		xbl_aop_region@45e00000 {
			no-map;
			reg = <0x00 0x45e00000 0x00 0x140000>;
			phandle = <0x13a>;
		};

		sec_apps_region@45fff000 {
			no-map;
			reg = <0x00 0x45fff000 0x00 0x1000>;
			phandle = <0x13b>;
		};

		smem_region@46000000 {
			no-map;
			reg = <0x00 0x46000000 0x00 0x200000>;
			phandle = <0x63>;
		};

		removed_region@60000000 {
			no-map;
			reg = <0x00 0x60000000 0x00 0x3900000>;
			phandle = <0x13c>;
		};

		modem_region@4ab00000 {
			no-map;
			reg = <0x00 0x4ab00000 0x00 0x6900000>;
			phandle = <0x71>;
		};

		wlan_msa_region@51900000 {
			no-map;
			reg = <0x00 0x51900000 0x00 0x100000>;
			phandle = <0x13d>;
		};

		cdsp_regions@51a00000 {
			no-map;
			reg = <0x00 0x51a00000 0x00 0x1e00000>;
			phandle = <0x33>;
		};

		pil_adsp_region@53800000 {
			no-map;
			reg = <0x00 0x53800000 0x00 0x1e00000>;
			phandle = <0x2e>;
		};

		ipa_fw_region@55600000 {
			no-map;
			reg = <0x00 0x55600000 0x00 0x10000>;
			phandle = <0x77>;
		};

		ipa_gsi_region@55610000 {
			no-map;
			reg = <0x00 0x55610000 0x00 0x5000>;
			phandle = <0x13e>;
		};

		gpu_region@55615000 {
			no-map;
			reg = <0x00 0x55615000 0x00 0x2000>;
			phandle = <0x13f>;
		};

		video_region@55617000 {
			no-map;
			reg = <0x00 0x55617000 0x00 0x700000>;
			phandle = <0x140>;
		};

		user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x86>;
		};

		non_secure_display_region {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			size = <0x00 0xa400000>;
			alignment = <0x00 0x400000>;
			phandle = <0x87>;
		};

		qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x24>;
		};

		qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x25>;
		};

		cdsp_sec_regions@46200000 {
			no-map;
			reg = <0x00 0x46200000 0x00 0x1e00000>;
			phandle = <0x84>;
		};

		secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x5c00000>;
			phandle = <0x85>;
		};

		adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0x69>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x800000>;
			phandle = <0x36>;
		};

		ramoops_region {
			compatible = "ramoops";
			alloc-ranges = <0x00 0x00 0xffffffff 0xffffffff>;
			size = <0x00 0x200000>;
			pmsg-size = <0x200000>;
			mem-type = <0x02>;
			phandle = <0x141>;
		};

		audio_cma_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1c00000>;
			phandle = <0x88>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
			phandle = <0xf0>;
		};

		va_md_mem_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x1000000>;
			phandle = <0x61>;
		};
	};

	chosen {
		bootargs = "lpm_levels.sleep_disabled=1 console=ttyMSM0,115200n8 msm_rtb.filter=0x237 service_locator.enable=1 swiotlb=2048 loop.max_part=7 cpufreq.default_governor=performance rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off export_pmu_events movable_node ftrace_dump_on_oops ssbd=force-off disable_dma32=on cgroup.memory=nokmem,nosocket panic=5";
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0x142>;

		interconnect {
			compatible = "qcom,bengal-clk_virt";
			qcom,keepalive;
			#interconnect-cells = <0x01>;
			clock-names = "bus", "bus_a";
			clocks = <0x1c 0x6a 0x1c 0x6b>;
			phandle = <0xf6>;
		};

		interconnect@0 {
			compatible = "qcom,bengal-mmnrt_virt";
			#interconnect-cells = <0x01>;
			qcom,util-factor = <0x8e>;
			qcom,keepalive;
			clock-names = "bus", "bus_a";
			clocks = <0x1c 0x6e 0x1c 0x6f>;
			phandle = <0xee>;
		};

		interconnect@1 {
			compatible = "qcom,bengal-mmrt_virt";
			#interconnect-cells = <0x01>;
			qcom,util-factor = <0x8b>;
			qcom,keepalive;
			clock-names = "bus", "bus_a";
			clocks = <0x1c 0x6c 0x1c 0x6d>;
			phandle = <0xec>;
		};

		interconnect@1880000 {
			compatible = "qcom,bengal-system_noc";
			reg = <0x1880000 0x5f080>;
			#interconnect-cells = <0x01>;
			qcom,keepalive;
			clock-names = "bus", "bus_a";
			clocks = <0x1c 0x04 0x1c 0x05 0x1d 0x38 0x1d 0x74>;
			phandle = <0x28>;
		};

		interconnect@1900000 {
			compatible = "qcom,bengal-config_noc";
			reg = <0x1900000 0x6200>;
			#interconnect-cells = <0x01>;
			qcom,keepalive;
			clock-names = "bus", "bus_a";
			clocks = <0x1c 0x1c 0x1c 0x1d>;
			phandle = <0x27>;
		};

		interconnect@4480000 {
			compatible = "qcom,bengal-bimc";
			reg = <0x4480000 0x80000>;
			#interconnect-cells = <0x01>;
			qcom,util-factor = <0x99>;
			qcom,keepalive;
			clock-names = "bus", "bus_a";
