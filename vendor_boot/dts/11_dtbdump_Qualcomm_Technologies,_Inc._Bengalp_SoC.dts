			interrupts = <0x00 0x113 0x04 0x00 0xbe 0x04>;
			interrupt-names = "tsens-upper-lower", "tsens-critical";
			tsens-reinit-wa;
			#thermal-sensor-cells = <0x01>;
			interrupts-extended = <0x01 0x00 0x113 0x04 0x5a 0x02 0x04>;
			phandle = <0x3d>;
