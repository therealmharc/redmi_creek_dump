						pins = "gpio5";
					};
				};

				dmic01_clk_active {
					phandle = <0x24a>;

					mux {
						function = "func1";
						pins = "gpio6";
					};

					config {
						output-high;
						drive-strength = <0x08>;
						pins = "gpio6";
					};
				};

				dmic01_clk_sleep {
					phandle = <0x24c>;

					mux {
						function = "func1";
						pins = "gpio6";
					};

					config {
						output-low;
						bias-disable;
						drive-strength = <0x02>;
						pins = "gpio6";
					};
				};

				dmic01_data_active {
					phandle = <0x24b>;

					mux {
						function = "func1";
						pins = "gpio7";
					};

					config {
						input-enable;
						drive-strength = <0x08>;
						pins = "gpio7";
					};
				};

				dmic01_data_sleep {
					phandle = <0x24d>;

					mux {
						function = "func1";
						pins = "gpio7";
					};

					config {
						input-enable;
						pull-down;
						drive-strength = <0x02>;
						pins = "gpio7";
					};
				};

				dmic23_clk_active {
					phandle = <0x24e>;

					mux {
						function = "func1";
						pins = "gpio8";
					};

					config {
						output-high;
						drive-strength = <0x08>;
						pins = "gpio8";
					};
				};

				dmic23_clk_sleep {
					phandle = <0x250>;

					mux {
						function = "func1";
						pins = "gpio8";
					};

					config {
						output-low;
						bias-disable;
						drive-strength = <0x02>;
						pins = "gpio8";
					};
				};

				dmic23_data_active {
					phandle = <0x24f>;

					mux {
						function = "func1";
						pins = "gpio9";
					};

					config {
						input-enable;
						drive-strength = <0x08>;
						pins = "gpio9";
					};
				};

				dmic23_data_sleep {
					phandle = <0x251>;

					mux {
						function = "func1";
						pins = "gpio9";
					};

					config {
						input-enable;
						pull-down;
						drive-strength = <0x02>;
						pins = "gpio9";
					};
				};

				wsa_mclk_sleep {
					phandle = <0x25f>;

					mux {
						function = "func1";
						pins = "gpio18";
					};

					config {
