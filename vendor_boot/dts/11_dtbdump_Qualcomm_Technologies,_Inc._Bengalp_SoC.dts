			rx_swr_clk_data_pinctrl {
				phandle = <0x2d6>;
				#gpio-cells = <0x00>;
				qcom,lpi-gpios;
				pinctrl-1 = <0x255 0x256 0x257>;
				pinctrl-0 = <0x252 0x253 0x254>;
				pinctrl-names = "aud_active", "aud_sleep";
				compatible = "qcom,msm-cdc-pinctrl";
			};

			va_swr_clk_data_pinctrl {
				phandle = <0x2d7>;
				#gpio-cells = <0x00>;
				qcom,chip-wakeup-default-val = <0x01>;
				qcom,chip-wakeup-maskbit = <0x00>;
				qcom,chip-wakeup-reg = <0x3ca04c>;
				qcom,lpi-gpios;
				pinctrl-1 = <0x25b 0x25c 0x25d>;
				pinctrl-0 = <0x258 0x259 0x25a>;
				pinctrl-names = "aud_active", "aud_sleep";
				compatible = "qcom,msm-cdc-pinctrl";
			};

			msm_cdc_pinctrl@18 {
				phandle = <0x2d8>;
				#gpio-cells = <0x00>;
				qcom,lpi-gpios;
				pinctrl-1 = <0x25f>;
				pinctrl-0 = <0x25e>;
				pinctrl-names = "aud_active", "aud_sleep";
				compatible = "qcom,msm-cdc-pinctrl";
			};

			bolero-codec {
				phandle = <0x2d9>;
				clocks = <0x249 0x00>;
				clock-names = "lpass_audio_hw_vote";
				compatible = "qcom,bolero-codec";

				bolero-clk-rsc-mngr {
					compatible = "qcom,bolero-clk-rsc-mngr";
				};

				va-macro@a730000 {
					phandle = <0x2da>;

					va_swr_master {
						phandle = <0x2db>;
					};
				};

				rx-macro@a600000 {
					phandle = <0x2dc>;

					rx_swr_master {
						phandle = <0x2dd>;
					};
				};
			};

			sound {
				phandle = <0x2de>;
				qcom,afe-rxtx-lb = <0x00>;
				qcom,wcn-btfm = <0x00>;
				qcom,tdm-audio-intf = <0x00>;
				qcom,auxpcm-audio-intf = <0x00>;
				qcom,mi2s-audio-intf = <0x00>;
				compatible = "qcom,bengal-asoc-snd";
			};
		};

		vote_lpass_audio_hw {
			phandle = <0x249>;
			#clock-cells = <0x01>;
			qcom,codec-ext-clk-src = <0x0b>;
			compatible = "qcom,audio-ref-clk";
		};

		qcom,kgsl-iommu@59a0000 {
			phandle = <0x2e1>;
			vddcx-supply = <0xea>;
			reg = <0x59a0000 0x10000>;
			compatible = "qcom,kgsl-smmu-v2";

			gfx3d_user {
				phandle = <0x2e2>;
				qcom,gpu-offset = <0xa8000>;
				qcom,iommu-dma = "disabled";
				iommus = <0x1e3 0x00 0x01>;
				label = "gfx3d_user";
				compatible = "qcom,smmu-kgsl-cb";
			};

			gfx3d_secure {
				phandle = <0x2e3>;
				qcom,iommu-dma = "disabled";
				iommus = <0x1e3 0x02 0x00>;
				label = "gfx3d_secure";
				compatible = "qcom,smmu-kgsl-cb";
			};
		};
	};

