		goodix_fp {
			compatible = "xiaomi,goodixfingerprint";
			interrupt-parent = <0x1f>;
			interrupt = <0x53 0x01>;
			fp-gpio-irq = <0x1f 0x53 0x00>;
			fp-gpio-reset = <0x1f 0x68 0x00>;
			pinctrl-names = "xiaomifp_reset_outputlow", "xiaomifp_reset_outputhigh", "xiaomifp_irq_active", "xiaomifp_ldo_outputlow", "xiaomifp_ldo_outputhigh";
			pinctrl-0 = <0xf1>;
			pinctrl-1 = <0xf2>;
			pinctrl-2 = <0xf3>;
			pinctrl-3 = <0xf4>;
			pinctrl-4 = <0xf5>;
			status = "okay";
		};

		silead_fp {
			compatible = "sil,silead_fp";
			interrupt-parent = <0x1f>;
			interrupts = <0x53 0x01>;
			irq-gpios = <0x1f 0x53 0x00>;
			rst-gpios = <0x1f 0x68 0x00>;
			pinctrl-names = "xiaomifp_ldo_outputhigh";
			pinctrl-0 = <0xf5>;
			status = "okay";
		};

		xiaomi_fingerprint {
			compatible = "xiaomi-fingerprint";
			status = "ok";
			fingerprint,name = "xiaomi-fingerprint";
		};

		qcom,gpi-dma@4a00000 {
			compatible = "qcom,gpi-dma";
			#dma-cells = <0x05>;
			reg = <0x4a00000 0x60000>;
			reg-names = "gpi-top";
			interrupts = <0x00 0x14f 0x04 0x00 0x150 0x04 0x00 0x151 0x04 0x00 0x152 0x04 0x00 0x153 0x04 0x00 0x154 0x04 0x00 0x155 0x04 0x00 0x156 0x04 0x00 0x157 0x04 0x00 0x158 0x04>;
			qcom,max-num-gpii = <0x0a>;
			qcom,gpii-mask = <0x0f>;
