		pinctrl@500000 {
			compatible = "qcom,scuba-pinctrl";
			reg = <0x500000 0x300000>;
			interrupts = <0x00 0xe3 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			wakeup-parent = <0xa4>;
			phandle = <0x56>;

			qupv3_se4_2uart_pins {
				phandle = <0x18b>;

				qupv3_se4_2uart_active {
					phandle = <0xad>;

					mux {
						pins = "gpio12", "gpio13";
						function = "qup4";
					};

					config {
						pins = "gpio12", "gpio13";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				qupv3_se4_2uart_sleep {
					phandle = <0xae>;

					mux {
						pins = "gpio12", "gpio13";
						function = "gpio";
					};

					config {
						pins = "gpio12", "gpio13";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			sdc1_on {
				phandle = <0x18c>;

				clk {
					pins = "sdc1_clk";
					bias-disable;
					drive-strength = <0x10>;
				};

				cmd {
					pins = "sdc1_cmd";
					bias-pull-up;
					drive-strength = <0x0a>;
				};

				data {
					pins = "sdc1_data";
					bias-pull-up;
					drive-strength = <0x0a>;
				};

				rclk {
					pins = "sdc1_rclk";
					bias-pull-down;
				};
			};

			sdc1_off {
				phandle = <0x18d>;

				clk {
					pins = "sdc1_clk";
					bias-disable;
					drive-strength = <0x02>;
