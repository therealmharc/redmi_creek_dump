					red {
						label = "red";
						pwms = <0x54 0x00 0xf4240>;
						max-brightness = <0xff>;
						linux,default-trigger = "timer";
					};

					green {
						label = "green";
						pwms = <0x55 0x00 0xf4240>;
						max-brightness = <0xff>;
						linux,default-trigger = "timer";
					};
				};

				qcom,flash_led@d300 {
					compatible = "qcom,pm2250-flash-led";
					reg = <0xd300>;
					interrupts = <0x01 0xd3 0x00 0x01 0x01 0xd3 0x03 0x01 0x01 0xd3 0x04 0x01>;
					interrupt-names = "led-fault-irq", "all-ramp-down-done-irq", "all-ramp-up-done-irq";
					phandle = <0x13d>;

					qcom,flash_0 {
						label = "flash";
						qcom,led-name = "led:flash_0";
						qcom,max-current-ma = <0x3e8>;
						qcom,default-led-trigger = "flash0_trigger";
						qcom,id = <0x00>;
						qcom,duration-ms = <0x500>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x13e>;
					};

					qcom,torch_0 {
						label = "torch";
						qcom,led-name = "led:torch_0";
						qcom,max-current-ma = <0xc8>;
						qcom,default-led-trigger = "torch0_trigger";
						qcom,id = <0x00>;
						qcom,ires-ua = <0x30d4>;
						phandle = <0x13f>;
					};

					qcom,led_switch_0 {
						label = "switch";
