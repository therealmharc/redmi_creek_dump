/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Scuba IOT 2GB DDR SoC";
	compatible = "qcom,scuba-iot";
	qcom,msm-id = <0x1d9 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x400>;

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x200>;
	};

	aliases {
		mmc0 = "/soc/sdhci@4744000";
		mmc1 = "/soc/sdhci@4784000";
		serial0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a90000";
		hsuart0 = "/soc/qcom,qupv3_0_geni_se@4ac0000/qcom,qup_uart@4a8c000";
		phandle = <0xdf>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x00>;
			cpu-idle-states = <0x02>;
			power-domains = <0x03>;
			power-domain-names = "psci";
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x04>;
			qcom,lmh-dcvs = <0x06>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				phandle = <0x04>;
			};

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0xe0>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0xe1>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x01>;
			cpu-idle-states = <0x02>;
			power-domains = <0x07>;
			power-domain-names = "psci";
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x04>;
			qcom,lmh-dcvs = <0x06>;
			phandle = <0x0b>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0xe2>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0xe3>;
			};
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x02>;
			cpu-idle-states = <0x02>;
			power-domains = <0x08>;
			power-domain-names = "psci";
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x04>;
			qcom,lmh-dcvs = <0x06>;
			phandle = <0x0c>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0xe4>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0xe5>;
			};
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x00 0x03>;
			cpu-idle-states = <0x02>;
			power-domains = <0x09>;
			power-domain-names = "psci";
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			next-level-cache = <0x04>;
			qcom,freq-domain = <0x05 0x00 0x04>;
			qcom,lmh-dcvs = <0x06>;
			phandle = <0x0d>;

			l1-icache {
				compatible = "arm,arch-cache";
				phandle = <0xe6>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				phandle = <0xe7>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0a>;
				};

				core1 {
					cpu = <0x0b>;
				};

				core2 {
					cpu = <0x0c>;
				};

				core3 {
					cpu = <0x0d>;
				};
			};
		};
	};

	idle-states {

		silver-c3 {
			compatible = "arm,idle-state";
			idle-state-name = "pc";
			entry-latency-us = <0x129>;
			exit-latency-us = <0x144>;
			min-residency-us = <0x456>;
			arm,psci-suspend-param = <0x40000003>;
			local-timer-stop;
			phandle = <0x02>;
		};

		silver-cluster-d3 {
			compatible = "domain-idle-state";
			idle-state-name = "pwr-l2-pc";
			entry-latency-us = <0x320>;
			exit-latency-us = <0x846>;
			min-residency-us = <0x1cd0>;
			arm,psci-suspend-param = <0x41000043>;
			phandle = <0x0f>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		cpu-pd0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x0e>;
			phandle = <0x03>;
		};

		cpu-pd1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x0e>;
			phandle = <0x07>;
		};

		cpu-pd2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x0e>;
			phandle = <0x08>;
		};

		cpu-pd3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x0e>;
			phandle = <0x09>;
		};

		cluster-pd0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x0f>;
			phandle = <0x0e>;
		};
	};

	firmware {
		phandle = <0xe8>;

		qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x10 0x13000>;
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor,dtbo,recovery";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/4744000.sdhci/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,slotselect,avb";
					status = "ok";
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xe9>;

		hyp_region@45700000 {
			no-map;
			reg = <0x00 0x45700000 0x00 0x600000>;
			phandle = <0xea>;
		};

		xbl_aop_mem@45e00000 {
			no-map;
			reg = <0x00 0x45e00000 0x00 0x100000>;
			phandle = <0xeb>;
		};

		sec_apps_region@45fff000 {
			no-map;
			reg = <0x00 0x45fff000 0x00 0x1000>;
			phandle = <0xec>;
		};

		smem@46000000 {
			no-map;
			reg = <0x00 0x46000000 0x00 0x200000>;
			phandle = <0x4b>;
		};

		modem_region@4ab00000 {
			no-map;
			reg = <0x00 0x4ab00000 0x00 0x6900000>;
			phandle = <0x1f>;
		};

		wlan_msa_region@51900000 {
			no-map;
			reg = <0x00 0x51900000 0x00 0x100000>;
			phandle = <0xed>;
		};

		adsp_regions@51a00000 {
			no-map;
			reg = <0x00 0x51a00000 0x00 0x1c00000>;
			phandle = <0x1a>;
		};

		ips_fw_region@53600000 {
			no-map;
			reg = <0x00 0x53600000 0x00 0x10000>;
			phandle = <0xee>;
		};

		ipa_gsi_region@53610000 {
			no-map;
			reg = <0x00 0x53610000 0x00 0x5000>;
			phandle = <0xef>;
		};

		gpu_region@53615000 {
			no-map;
			reg = <0x00 0x53615000 0x00 0x2000>;
			phandle = <0xf0>;
		};

		video_region@53617000 {
			no-map;
			reg = <0x00 0x53617000 0x00 0x700000>;
			phandle = <0xf1>;
		};

		adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x800000>;
			phandle = <0x4d>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x800000>;
			phandle = <0x3d>;
		};

		secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x5c00000>;
			phandle = <0xa5>;
		};

		non_secure_display_region {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			size = <0x00 0xa400000>;
			alignment = <0x00 0x400000>;
			phandle = <0xa7>;
		};

		qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x13>;
		};

		qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x400000>;
			phandle = <0xa6>;
		};

		ramoops_region {
			compatible = "ramoops";
			alloc-ranges = <0x00 0x00 0xffffffff 0xffffffff>;
			size = <0x00 0x200000>;
			pmsg-size = <0x200000>;
			mem-type = <0x02>;
			phandle = <0xf2>;
		};

		audio_cma_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1c00000>;
			phandle = <0xf3>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
			phandle = <0xda>;
		};

		va_md_mem_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x1000000>;
			phandle = <0x49>;
		};

		tz_removed_region@60000000 {
			no-map;
			reg = <0x00 0x60000000 0x00 0x100000>;
			phandle = <0xf4>;
		};

		pimem_removed_region@60100000 {
			no-map;
			reg = <0x00 0x60100000 0x00 0x1e00000>;
			phandle = <0xf5>;
		};
	};

	chosen {
		bootargs = "lpm_levels.sleep_disabled=1 console=ttyMSM0,115200n8 msm_rtb.filter=0x237 service_locator.enable=1 swiotlb=2048 loop.max_part=7 cpufreq.default_governor=performance rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kpti=off export_pmu_events movable_node ftrace_dump_on_oops disable_dma32=on cgroup.memory=nokmem,nosocket panic=5";
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";
		phandle = <0xf6>;

		bamdma@a584000 {
			compatible = "qcom,bam-v1.7.0";
			reg = <0xa584000 0x20000 0xa66f000 0x1000>;
			reg-names = "bam", "bam_remote_mem";
			#dma-cells = <0x01>;
			interrupts = <0x00 0x11c 0x04>;
			qcom,controlled-remotely;
			num-channels = <0x1f>;
			qcom,ee = <0x01>;
			qcom,num-ees = <0x02>;
			phandle = <0x11>;
		};

		slim@a5c0000 {
			compatible = "qcom,slim-ngd-v1.5.0";
			reg = <0xa5c0000 0x2c000 0xa66e000 0x1000>;
			reg-names = "ctrl", "slimbus_remote_mem";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0x11b 0x04>;
			qcom,apps-ch-pipes = <0x00>;
			qcom,ea-pc = <0x360>;
			dmas = <0x11 0x03 0x11 0x04>;
			dma-names = "rx", "tx";
			status = "disabled";
			phandle = <0xf7>;
		};

		interrupt-controller@f200000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			interrupt-controller;
			interrupt-parent = <0x01>;
			#redistributor-regions = <0x01>;
			redistributor-stride = <0x00 0x20000>;
			reg = <0xf200000 0x10000 0xf300000 0x100000>;
			interrupts = <0x01 0x09 0x04>;
			phandle = <0x01>;
		};

		interrupt-controller@0x45f01b8 {
			compatible = "qcom,mpm", "qcom,mpm-scuba";
			interrupts = <0x00 0xc5 0x01>;
			reg = <0x45f01b8 0x1000 0xf111008 0x04 0xf121000 0x1000>;
			reg-names = "vmpm", "ipc", "timer";
			qcom,num-mpm-irqs = <0x60>;
			interrupt-controller;
			interrupt-parent = <0x01>;
			#interrupt-cells = <0x02>;
			phandle = <0xa4>;
		};

		jtagmm@9040000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x9040000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x12 0x08>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x0a>;
			phandle = <0xf8>;
		};

		jtagmm@9140000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x9140000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x12 0x08>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x0b>;
			phandle = <0xf9>;
		};

		jtagmm@9240000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x9240000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x12 0x08>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x0c>;
			phandle = <0xfa>;
		};

		jtagmm@9340000 {
			compatible = "qcom,jtagv8-mm";
			reg = <0x9340000 0x1000>;
			reg-names = "etm-base";
			clocks = <0x12 0x08>;
			clock-names = "core_clk";
			qcom,coresight-jtagmm-cpu = <0x0d>;
			phandle = <0xfb>;
		};

		timer {
			compatible = "arm,armv8-timer";
			interrupts = <0x01 0x01 0xf08 0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x00 0xf08>;
			clock-frequency = <0x124f800>;
		};

		dcc_v2@1be2000 {
			compatible = "qcom,dcc-v2";
			reg = <0x1be2000 0x1000 0x1bee000 0x2000>;
			reg-names = "dcc-base", "dcc-ram-base";
			dcc-ram-offset = <0x2000>;
			phandle = <0xfc>;

			link_list1 {
				qcom,curr-link-list = <0x03>;
